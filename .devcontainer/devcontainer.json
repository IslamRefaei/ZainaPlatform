{
  "name": "ZainaPlatform Dev",
  "image": "mcr.microsoft.com/devcontainers/dotnet:9.0-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/postgresql:1": {
      "version": "16"
    }
  },
  "postCreateCommand": "dotnet tool install --global dotnet-ef && echo 'export PATH=$PATH:$HOME/.dotnet/tools' >> ~/.bashrc && psql -U postgres -c \"CREATE DATABASE zainaplatform;\" && echo 'ZainaPlatform dev environment ready ✓'",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-vscode",
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  },
  "forwardPorts": [5000, 5432],
  "portsAttributes": {
    "5000": { "label": "ZainaPlatform API" },
    "5432": { "label": "PostgreSQL" }
  },
  "remoteUser": "vscode"
}
