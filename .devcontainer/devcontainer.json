{
  "name": "LearnPath Dev",
  "image": "mcr.microsoft.com/devcontainers/dotnet:9.0",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "9.0"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/postgresql:1": {
      "version": "16"
    },
    "ghcr.io/devcontainers/features/redis:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-vscode",
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.fontSize": 14,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "dotnet tool install --global dotnet-ef && echo 'LearnPath dev environment ready ✓'",
  "forwardPorts": [5000, 5432, 6379],
  "portsAttributes": {
    "5000": { "label": "LearnPath API" },
    "5432": { "label": "PostgreSQL" },
    "6379": { "label": "Redis" }
  }
}
